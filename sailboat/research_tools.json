{
  "version": 1,
  "builtins": [
    "WebSearch"
  ],
  "max_calls": 2,
  "servers": {
    "huggingface": {
      "enabled": false,
      "url": "https://huggingface.co/mcp",
      "tools": {
        "hub_repo_search": {
          "read_only": true,
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 200
              },
              "repo_types": {
                "type": "array",
                "items": {
                  "enum": [
                    "dataset"
                  ]
                },
                "minItems": 1,
                "maxItems": 1
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "query",
              "repo_types",
              "limit"
            ]
          }
        }
      }
    }
  }
}
